{
  "id": "{{code}}_translate_eval",
  "name": "{{lang_name}} translate + evaluate",
  "description": "Baseline: translate the held-out test split with the seed style guide + pool exemplars, then evaluate against the reference.",
  "project": "{{project}}",
  "nodes": [
    {
      "id": "terms",
      "type": "datasource",
      "pos": {
        "x": 40.0,
        "y": 60.0
      },
      "params": {
        "source": "{{test_split_source}}"
      },
      "inputs": {}
    },
    {
      "id": "exemplars",
      "type": "datasource",
      "pos": {
        "x": 40.0,
        "y": 240.0
      },
      "params": {
        "source": "{{pool_source}}"
      },
      "inputs": {}
    },
    {
      "id": "seed_guide",
      "type": "function",
      "pos": {
        "x": 40.0,
        "y": 400.0
      },
      "params": {
        "path": "{{seed_guide}}",
        "function": "style_guide"
      },
      "inputs": {}
    },
    {
      "id": "translate",
      "type": "function",
      "pos": {
        "x": 300.0,
        "y": 80.0
      },
      "params": {
        "model_key": "{{model_key}}",
        "output_tag": "{{code}}_baseline",
        "function": "translate"
      },
      "inputs": {
        "terms": "terms",
        "exemplars": "exemplars",
        "style_guide": "seed_guide"
      }
    },
    {
      "id": "evaluate",
      "type": "function",
      "pos": {
        "x": 560.0,
        "y": 80.0
      },
      "params": {
        "function": "evaluate"
      },
      "inputs": {
        "translations": "translate",
        "reference": "terms"
      }
    }
  ]
}
