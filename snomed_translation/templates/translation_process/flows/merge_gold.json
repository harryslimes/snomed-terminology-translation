{
  "id": "{{code}}-merge-gold",
  "name": "{{code}}_merge_gold",
  "description": "Merge a review round into the adjudicated gold set with supersession — the single place 'currently adjudicated' is decided. Recency wins: a new round replaces older rows for the same concept, and older rows whose text violates the CURRENT rule file are withheld to the superseded output (the reviewer's confirmation list — never a silent drop). The newest round is never rule-checked away; its contradictions with older rulings go to the editorial-rulings ledger. After merging, copy the merged output over the {{code}}_sme_adjudicated source CSV (or repoint lock/overlay datasources at the promoted object) so the lock and overlay follow. Promotes {{code}}_adjudicated_merged + {{code}}_superseded.",
  "project": "{{project}}",
  "nodes": [
    {
      "id": "gold",
      "type": "datasource",
      "pos": {
        "x": 40.0,
        "y": 120.0
      },
      "params": {
        "source": "{{code}}_sme_adjudicated"
      },
      "inputs": {}
    },
    {
      "id": "round",
      "type": "datasource",
      "pos": {
        "x": 40.0,
        "y": 300.0
      },
      "params": {
        "data_object": "{{code}}_round_sample"
      },
      "inputs": {}
    },
    {
      "id": "merge",
      "type": "function",
      "pos": {
        "x": 380.0,
        "y": 200.0
      },
      "params": {
        "rules_file": "{{configs_dir}}/hard_rules/{{code}}.yaml",
        "severities": "blocker,warning",
        "batch_label": "round",
        "output_tag": "merge",
        "function": "merge_adjudicated_gold"
      },
      "inputs": {
        "gold": "gold",
        "round": "round"
      }
    },
    {
      "id": "headline",
      "type": "function",
      "pos": {
        "x": 720.0,
        "y": 100.0
      },
      "params": {
        "expression": "n_merged",
        "output_name": "adjudicated_rows",
        "function": "evaluate_formula"
      },
      "inputs": {
        "metrics": "merge:metrics"
      }
    },
    {
      "id": "promote_merged",
      "type": "promote",
      "pos": {
        "x": 720.0,
        "y": 240.0
      },
      "params": {
        "name": "{{code}}_adjudicated_merged",
        "type": "dataset"
      },
      "inputs": {
        "value": "merge:merged"
      }
    },
    {
      "id": "promote_superseded",
      "type": "promote",
      "pos": {
        "x": 720.0,
        "y": 380.0
      },
      "params": {
        "name": "{{code}}_superseded",
        "type": "dataset"
      },
      "inputs": {
        "value": "merge:superseded"
      }
    }
  ]
}
