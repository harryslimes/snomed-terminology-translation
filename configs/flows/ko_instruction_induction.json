{
  "id": "ko_instruction_induction",
  "name": "KO instruction induction",
  "description": "Induce an EN->KO SNOMED translation instruction guide from a pruned corpus (model critiques + gold minimal/diverse pairs + breadth) using Opus via the Claude Agent SDK. The corpus (text_source) and the prompt (prompt_source) are wired in as nodes. Build the corpus first: scripts/data_prep/build_induction_corpus.py. The output is a `text`/`style_guide` artifact that wires into a translate node or seeds GEPA (optimize).",
  "nodes": [
    {
      "id": "corpus",
      "type": "function",
      "pos": {"x": 80.0, "y": 60.0},
      "params": {
        "function": "text_source",
        "path": "data/evals/korean/induction_corpus.md"
      },
      "inputs": {}
    },
    {
      "id": "prompt_src",
      "type": "function",
      "pos": {"x": 80.0, "y": 300.0},
      "params": {
        "function": "prompt_source",
        "prompt_template": "ko_instruction_induction"
      },
      "inputs": {}
    },
    {
      "id": "induce_guide",
      "type": "function",
      "pos": {"x": 480.0, "y": 160.0},
      "params": {
        "function": "generate_text",
        "model": "claude-opus",
        "thinking": true,
        "effort": "high",
        "max_thinking_tokens": 32000,
        "output_tag": "ko_induced_guide",
        "output_ext": "md",
        "max_context_chars": 600000
      },
      "inputs": {
        "prompt": "prompt_src:prompt",
        "context": "corpus:text"
      }
    },
    {
      "id": "promote",
      "type": "function",
      "pos": {"x": 900.0, "y": 160.0},
      "params": {
        "function": "promote_prompt",
        "id": "ko_induced_guide",
        "name": "KO induced translation guide",
        "kind": "style_guide",
        "origin": "ko_instruction_induction",
        "tags": "ko,snomed,induced"
      },
      "inputs": {
        "prompt": "induce_guide:text"
      }
    }
  ]
}
