      "pos": {
        "x": 40.0,
        "y": 60.0
      },
      "params": {
        "source": "sme_gold_test"
      },
      "inputs": {}
    },
    {
      "id": "exemplars",
      "type": "datasource",
      "pos": {
        "x": 40.0,
        "y": 240.0
      },
      "params": {
        "source": "pooled_legacy"
      },
      "inputs": {}
    },
    {
      "id": "style",
      "type": "function",
      "pos": {
        "x": 40.0,
        "y": 380.0
      },
      "params": {
        "path": "style_guide/style_guide_ko_v6_0.md",
        "function": "style_guide"
      },
      "inputs": {}
    },
    {
      "id": "translate",
      "type": "function",
      "pos": {
        "x": 300.0,
        "y": 60.0
      },
      "params": {
        "model_key": "gemma4-26b-qat",
        "output_tag": "sme_gold_baseline",
        "resume": false,
        "request_timeout_seconds": 180,
        "max_attempts": 3,
        "function": "translate"
      },
      "inputs": {
        "terms": "terms",
        "exemplars": "exemplars",
        "style_guide": "style:style_guide"
      }
    },
    {
      "id": "evaluate",
      "type": "function",
      "pos": {
        "x": 540.0,
        "y": 60.0
      },
      "params": {
        "function": "evaluate"
      },
      "inputs": {
        "translations": "translate",
        "reference": "terms"
