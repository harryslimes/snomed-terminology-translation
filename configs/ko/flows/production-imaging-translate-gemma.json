{
  "id": "production-imaging-translate-gemma",
  "name": "production_imaging_translate_gemma",
  "description": "Greedy (temp 0) gemma4-26b-qat translation of the 5,012 active imaging concepts under style guide v6.0 and the eval-safe curated pool — the SHIPPABLE gemma output, paired with the n_distinct confidence pass from the same model so the deliverable and its review ranking come from one model (same-model AUC 0.755, vs 0.609 cross-model). Note the sampling run's top_candidate is a majority pick and measured WORSE than greedy (35.0% vs 37.5%), so it is not used.",
  "project": "translation_prompt_context_v1",
  "nodes": [
    {
      "id": "terms",
      "type": "datasource",
      "pos": {
        "x": 40.0,
        "y": 60.0
      },
      "params": {
        "source": "production_imaging_pool"
      },
      "inputs": {}
    },
    {
      "id": "exemplars",
      "type": "datasource",
      "pos": {
        "x": 40.0,
        "y": 200.0
      },
      "params": {
        "source": "pooled_curated_eval"
      },
      "inputs": {}
    },
    {
      "id": "dict",
      "type": "datasource",
      "pos": {
        "x": 40.0,
        "y": 340.0
      },
      "params": {
        "source": "register_oracle_dict"
      },
      "inputs": {}
    },
    {
      "id": "style",
      "type": "function",
      "pos": {
        "x": 40.0,
        "y": 480.0
      },
      "params": {
        "path": "style_guide/style_guide_ko_v6_0.md",
        "function": "style_guide"
      },
      "inputs": {}
    },
    {
      "id": "translate",
      "type": "function",
      "pos": {
        "x": 320.0,
        "y": 60.0
      },
      "params": {
        "model_key": "gemma4-26b-qat",
        "output_tag": "production_imaging_v6_0_gemma",
        "resume": true,
        "request_timeout_seconds": 300,
        "max_attempts": 3,
        "function": "translate"
      },
      "inputs": {
        "terms": "terms",
        "exemplars": "exemplars",
        "style_guide": "style:style_guide"
      }
    },
    {
      "id": "contrast_audit",
      "type": "function",
      "pos": {
        "x": 600.0,
        "y": 60.0
      },
      "params": {
        "en_col": "preferred_term",
        "ko_col": "translation",
        "function": "contrast_fidelity_detect"
      },
      "inputs": {
        "translations": "translate:translations"
      }
    },
    {
      "id": "translit_audit",
      "type": "function",
      "pos": {
        "x": 600.0,
        "y": 200.0
      },
      "params": {
        "echo_threshold": 0.7,
        "en_col": "preferred_term",
        "ko_col": "translation",
        "label_col": "__none__",
        "function": "transliteration_detect"
      },
      "inputs": {
        "translations": "translate:translations",
        "dictionary": "dict"
      }
    },
    {
      "id": "judge",
      "type": "function",
      "pos": {
        "x": 600.0,
        "y": 340.0
      },
      "params": {
        "model": "cyankiwi/gemma-4-26B-A4B-it-qat-AWQ-INT4",
        "base_url": "http://localhost:8086",
        "concurrency": 16,
        "en_col": "preferred_term",
        "ko_col": "translation",
        "label_col": "__none__",
        "max_tokens": 220,
        "function": "acceptability_judge"
      },
      "inputs": {
        "translations": "translate:translations"
      }
    },
    {
      "id": "headline",
      "type": "function",
      "pos": {
        "x": 880.0,
        "y": 340.0
      },
      "params": {
        "expression": "(judged_partial + judged_wrong) / n_judged * 100",
        "output_name": "judge_review_rate_pct",
        "function": "evaluate_formula"
      },
      "inputs": {
        "metrics": "judge:metrics"
      }
    }
  ]
}