{
  "id": "cascade-gemma-qwen",
  "name": "cascade_gemma_qwen",
  "description": "Confidence-routed cascade on the 200-row SME gold: gemma samples 5 per concept; concepts where all 5 agreed keep gemma's answer, concepts where they disagreed are re-translated by Qwen 3.8-Max, which replays the ORIGINAL prompt (same style guide + retrieved exemplars) AND sees gemma's candidates with their counts, then generates freely. Estimated 42.5-43.5% from routing existing runs, vs gemma 36.0%, Qwen 38.0%, Opus 40.0%.",
  "project": "translation_prompt_context_v1",
  "nodes": [
    {"id": "terms", "type": "datasource", "pos": {"x": 40.0, "y": 60.0},
     "params": {"source": "sme_gold_all"}, "inputs": {}},
    {"id": "exemplars", "type": "datasource", "pos": {"x": 40.0, "y": 200.0},
     "params": {"source": "pooled_curated_eval"}, "inputs": {}},
    {"id": "style", "type": "function", "pos": {"x": 40.0, "y": 340.0},
     "params": {"path": "style_guide/style_guide_ko_v6_0.md", "function": "style_guide"}, "inputs": {}},
    {"id": "sample", "type": "function", "pos": {"x": 340.0, "y": 60.0},
     "params": {"model_key": "gemma4-26b-qat", "samples": 5, "temperature": 0.7,
                "output_tag": "cascade_gemma_qwen", "function": "translate_consistency"},
     "inputs": {"terms": "terms", "exemplars": "exemplars", "style_guide": "style:style_guide"}},
    {"id": "cascade", "type": "function", "pos": {"x": 640.0, "y": 60.0},
     "params": {"model": "qwen3.8-max", "base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode",
                "api_key_env": "DASHSCOPE_API_KEY", "min_distinct": 2,
                "show_candidates": true, "concurrency": 8,
                "output_tag": "gemma_qwen", "function": "escalate_uncertain"},
     "inputs": {"candidates": "sample"}},
    {"id": "evaluate", "type": "function", "pos": {"x": 940.0, "y": 60.0},
     "params": {"function": "evaluate"},
     "inputs": {"translations": "cascade:translations", "reference": "terms"}},
    {"id": "headline", "type": "function", "pos": {"x": 1240.0, "y": 60.0},
     "params": {"expression": "exact_match_pct", "output_name": "cascade_exact_pct",
                "function": "evaluate_formula"},
     "inputs": {"metrics": "evaluate:metrics"}}
  ]
}
