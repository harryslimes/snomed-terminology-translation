{
  "version": 1,
  "name": "sme_gold_assets_v1",
  "description": "Turn the batch-1 + batch-2 SME reviews into reusable gold assets: per-term canonical gold (SME correction for Partial/Wrong, sent translation for Correct/Acceptable) plus acceptable-synonym alternates mined from ratings/notes (multi-reference). Emit train/dev/held-out-test splits (held-out never touches GEPA). Sources: sme_gold_train / sme_gold_dev / sme_gold_test. The build is a versioned script (scripts/sme_review/build_sme_gold.py) with an audit JSON recording counts and split membership; downstream evals/GEPA consume the registered sources only.",
  "environment": {
    "version": 1,
    "name": "project",
    "description": "",
    "language": {
      "code": "ko",
      "name": "Korean",
      "direction": "EN->KO",
      "tokenizer_lang": "en"
    },
    "paths": {
      "root": ".",
      "data_dir": "data",
      "output_dir": "data/evals/korean",
      "lookup_cache": "data/evals/korean/lookup_cache.json"
    },
    "qdrant": {
      "url": "http://localhost:6333",
      "bgem3": {
        "model_name": "BAAI/bge-m3",
        "use_fp16": false,
        "batch_size": 256,
        "max_length": 512
      }
    },
    "overlap_defaults": {
      "prompt_addendum": "additive",
      "term_dictionary": "most_specific",
      "retrieval_corpus": "additive",
      "exemplar_set": "union_dedupe"
    },
    "default_model_key": "gemma4-26b"
  },
  "problem": "integrating-batch-2-sme-feedback-into-the-translation-recipe",
  "pool_output_csv": "data/EN-KO/all_bilingual_pairs.csv",
  "pool_dedup_key": [
    "en_lower",
    "target"
  ],
  "evaluation": {
    "scorers": [
      {
        "kind": "exact_match",
        "weight": 0.2,
        "params": {}
      },
      {
        "kind": "chrf",
        "weight": 0.5,
        "params": {}
      },
      {
        "kind": "cosine_similarity",
        "weight": 0.3,
        "params": {}
      }
    ],
    "multi_ref": true,
    "judge": {
      "kind": "none",
      "labels": [
        "ACCEPTABLE",
        "PARTIAL",
        "WRONG"
      ],
      "concurrency": 8
    }
  },
  "optimization": {
    "seed_style_guide": "style_guide/style_guide_ko_v5_1.md",
    "splits_dir": "data/evals/korean/dspy_splits",
    "lookup_cache": "data/sme_review/2026-04-24/lookup_cache.json",
    "gepa": {
      "auto": "medium",
      "track_stats": true
    },
    "reflection_candidates": [],
    "reflection_lm": {
      "model_id": "openai/qwen3.7-max",
      "base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
      "api_key_env": "DASHSCOPE_API_KEY",
      "disable_thinking": true,
      "temperature": 1.0,
      "max_tokens": 4000
    },
    "hints_file": "configs/hints/ko.yaml"
  }
}