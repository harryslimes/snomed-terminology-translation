{
  "version": 1,
  "name": "fable_gepa_judge_v1",
  "description": "Assess Claude Fable 5 as the LLM feedback-judge inside GEPA prompt optimisation for EN->KO SNOMED translation. GEPA seeds from ko_minimal_seed (a one-line template), task+reflection LM = gemma4-26b-qat (served vLLM), reward = BGE-M3 semantic cosine to the gold Korean (exact->1.0), and Claude Fable 5 writes the sparse reflective feedback GEPA learns from (gated to genuine reflection, score<threshold, capped ~40 calls, cached). The optimised prompt is evaluated on the held-out kr_test_split (124) vs hand guide v5_1 (58.1% exact / 84.1 chrF on test). Question: can Fable's judgment alone drive GEPA from a one-line seed to a prompt that beats/approaches the hand guide?",
  "environment": {
    "version": 1,
    "name": "project",
    "description": "",
    "language": {
      "code": "ko",
      "name": "Korean",
      "direction": "EN->KO",
      "tokenizer_lang": "en"
    },
    "paths": {
      "root": ".",
      "data_dir": "data",
      "output_dir": "data/evals/korean",
      "lookup_cache": "data/evals/korean/lookup_cache.json"
    },
    "qdrant": {
      "url": "http://localhost:6333",
      "bgem3": {
        "model_name": "BAAI/bge-m3",
        "use_fp16": false,
        "batch_size": 256,
        "max_length": 512
      }
    },
    "overlap_defaults": {
      "prompt_addendum": "additive",
      "term_dictionary": "most_specific",
      "retrieval_corpus": "additive",
      "exemplar_set": "union_dedupe"
    },
    "default_model_key": "gemma4-26b"
  },
  "problem": "translation-prompt-context",
  "pool_output_csv": "data/EN-KO/all_bilingual_pairs.csv",
  "pool_dedup_key": [
    "en_lower",
    "target"
  ],
  "evaluation": {
    "scorers": [
      {
        "kind": "exact_match",
        "weight": 0.2,
        "params": {}
      },
      {
        "kind": "chrf",
        "weight": 0.5,
        "params": {}
      },
      {
        "kind": "cosine_similarity",
        "weight": 0.3,
        "params": {}
      }
    ],
    "multi_ref": true,
    "judge": {
      "kind": "none",
      "labels": [
        "ACCEPTABLE",
        "PARTIAL",
        "WRONG"
      ],
      "concurrency": 8
    }
  },
  "optimization": {
    "seed_template": "ko_minimal_seed",
    "metric": "semantic",
    "judge_model_key": "claude-fable",
    "max_judge_calls": 40,
    "judge_threshold": 0.9,
    "splits_dir": "data/evals/korean/dspy_splits",
    "lookup_cache": "data/sme_review/2026-04-24/lookup_cache.json",
    "hard_rules_file": "configs/hard_rules/ko.yaml",
    "hints_file": "configs/hints/ko.yaml",
    "gepa": {
      "auto": "light",
      "track_stats": true
    },
    "reflection_candidates": []
  },
  "sme": {
    "sample_size": 100,
    "stratify_by": [
      "modality",
      "hierarchy"
    ],
    "output_dir": "data/sme_review",
    "reviewer": {
      "kind": "sonnet"
    },
    "prepare_lookups": true
  }
}